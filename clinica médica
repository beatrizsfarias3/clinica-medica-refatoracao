-- BANCO ANTIGO (COM PROBLEMAS DE REDUNDÂNCIA)

CREATE TABLE Atendimentos (

    id_atendimento INTEGER PRIMARY KEY,

    nome_paciente VARCHAR(100),
    cpf_paciente VARCHAR(14),
    rg_paciente VARCHAR(20),
    data_nascimento DATE,
    sexo VARCHAR(20),
    telefone_paciente VARCHAR(20),
    email_paciente VARCHAR(100),
    endereco_paciente VARCHAR(200),
    bairro_paciente VARCHAR(100),
    cidade_paciente VARCHAR(100),
    estado_paciente VARCHAR(2),

    nome_plano VARCHAR(100),
    numero_carteirinha VARCHAR(50),
    validade_plano DATE,

    nome_medico VARCHAR(100),
    crm_medico VARCHAR(20),
    especialidade_medico VARCHAR(100),
    telefone_medico VARCHAR(20),
    email_medico VARCHAR(100),

    data_consulta DATETIME,
    horario_consulta TIME,
    sala_consulta VARCHAR(20),
    tipo_consulta VARCHAR(50),
    status_consulta VARCHAR(50),

    peso DECIMAL(5,2),
    altura DECIMAL(4,2),
    pressao_arterial VARCHAR(20),
    temperatura DECIMAL(4,1),

    sintomas TEXT,
    diagnostico TEXT,
    prescricao TEXT,
    observacoes TEXT,

    valor_consulta DECIMAL(10,2),
    forma_pagamento VARCHAR(50),
    data_pagamento DATE,

    atendente VARCHAR(100),
    data_cadastro DATETIME
);

